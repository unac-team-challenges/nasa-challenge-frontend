# Copia a .env (cp .env.example .env). Las variables VITE_ se leen al COMPILAR: tras cambiarlas,
# reinicia `pnpm dev` o vuelve a desplegar en Vercel.
#
# El front tiene dos fuentes de datos:
#   - API: el backend (Rust + Axum), la fuente real.
#   - Local: copia incluida en el repo (src/data/*.json), sirve de mock y de respaldo.

# URL de la API del backend, sin "/" final.
#   En local: `cargo run` en nasa-challenge-backend (puerto 3000).
#   En Vercel: la URL del servicio del backend en Render.
# Sin esta variable el front usa solo la copia local.
VITE_API_URL=http://localhost:3000

# Qué fuente usar (opcional):
#   (vacío)  API; si falla, tarda más de 4 s o viene incompleta, cae a la copia local. Es lo normal.
#   local    solo la copia local, sin llamar a la API aunque VITE_API_URL esté puesta.
#            Útil para trabajar sin backend o para comparar contra los datos locales.
VITE_FUENTE_DATOS=
