{
  "openapi": "3.1.0",
  "info": {
    "title": "Detective del Perú",
    "description": "API de solo lectura: sirve resultados ya calculados.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/celdas": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "T2M anual de cada celda de NASA POWER (~0,5° × 0,625°) dentro de Perú, para el mapa de calor.\nSolo existe para `temperatura`.",
        "operationId": "celdas",
        "parameters": [
          {
            "name": "variable",
            "in": "query",
            "description": "Obligatoria; solo temperatura",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Malla"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/api/cobertura-arboles": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Cobertura de árboles (MODIS MOD44B) de recuadros de selva, donde el NDVI se satura: cada zona con\nsu serie anual (`arboles_pct`, `area_bosque_km2`), su tendencia y su `unidad_geografica`\n(un recuadro, **no** el promedio del departamento).",
        "operationId": "cobertura",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZonaCobertura"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/variables": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Variables del producto con unidad, fuente y rango de años (`data/variables.json`).",
        "operationId": "variables",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VariableInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/vegetacion": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Vegetación (NDVI de MODIS) de los valles irrigados de la costa, para el Caso 2: cada zona con su\nserie anual (`ndvi_anual`, `area_verde_km2`), su tendencia y su `unidad_geografica` (un recuadro\nsobre el valle, **no** el promedio del departamento).",
        "operationId": "vegetacion",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZonaVegetacion"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/zonas": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Las 25 zonas (departamentos) con su tendencia, sin series.",
        "operationId": "zonas",
        "parameters": [
          {
            "name": "variable",
            "in": "query",
            "description": "Obligatoria: el plan B estático la necesita en la ruta",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Zona"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/api/zonas/{id}": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Serie anual y tendencia de una zona (`id` = ubigeo como texto, \"01\"–\"25\").",
        "operationId": "zona",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Ubigeo del departamento, como texto",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "15"
          },
          {
            "name": "variable",
            "in": "query",
            "description": "Obligatoria",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZonaDetalle"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnioCobertura": {
        "type": "object",
        "description": "Medidas de un año (MOD44B es un producto anual).",
        "required": [
          "anio",
          "arboles_pct",
          "area_bosque_km2"
        ],
        "properties": {
          "anio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "arboles_pct": {
            "type": "number",
            "format": "double",
            "description": "Cobertura de árboles media del recuadro, en % (0–100)."
          },
          "area_bosque_km2": {
            "type": "number",
            "format": "double",
            "description": "Área con cobertura de árboles mayor o igual que `umbral_bosque_pct`, en km²."
          }
        },
        "additionalProperties": false
      },
      "AnioVegetacion": {
        "type": "object",
        "description": "Medidas de un año completo (12 meses válidos).",
        "required": [
          "anio",
          "ndvi_anual",
          "area_verde_km2"
        ],
        "properties": {
          "anio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "area_verde_km2": {
            "type": "number",
            "format": "double",
            "description": "Área con NDVI medio del año mayor que `umbral_verde_ndvi`, en km²."
          },
          "ndvi_anual": {
            "type": "number",
            "format": "double",
            "description": "NDVI medio del año en el recuadro (−1 a 1)."
          }
        },
        "additionalProperties": false
      },
      "Celda": {
        "type": "object",
        "required": [
          "lat",
          "lon",
          "t2m"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "format": "double",
            "description": "Centro de la celda."
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "t2m": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "description": "Media anual en °C, una por año de `anio_inicio` a `anio_fin`; null si el año no está completo."
          }
        },
        "additionalProperties": false
      },
      "ErrorRespuesta": {
        "type": "object",
        "description": "Cuerpo de los errores 400 y 404.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Malla": {
        "type": "object",
        "description": "`data/celdas/temperatura.json`, tal cual lo deja `pipeline/power.py`.",
        "required": [
          "fuente",
          "unidad",
          "dlat",
          "dlon",
          "anio_inicio",
          "anio_fin",
          "celdas"
        ],
        "properties": {
          "anio_fin": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "anio_inicio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "celdas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Celda"
            }
          },
          "dlat": {
            "type": "number",
            "format": "double",
            "description": "Alto de la celda en grados de latitud.",
            "example": 0.5
          },
          "dlon": {
            "type": "number",
            "format": "double",
            "description": "Ancho de la celda en grados de longitud.",
            "example": 0.625
          },
          "fuente": {
            "type": "string",
            "example": "MERRA-2 vía NASA POWER (T2M)"
          },
          "unidad": {
            "type": "string",
            "example": "°C"
          }
        },
        "additionalProperties": false
      },
      "Punto": {
        "type": "object",
        "required": [
          "anio",
          "valor"
        ],
        "properties": {
          "anio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "valor": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Stats": {
        "type": "object",
        "description": "Tendencia lineal del periodo `year_start`–`year_end`, ya calculada por el pipeline.",
        "required": [
          "year_start",
          "year_end",
          "n_years",
          "slope_per_decade",
          "intercept",
          "ci_low",
          "ci_high",
          "p_value",
          "q_value",
          "lag1",
          "status"
        ],
        "properties": {
          "aviso": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cuidado al interpretar la tendencia: siempre en `lluvia_imerg` (salto de 2014) y si `lag1 > 0.5`."
          },
          "ci_high": {
            "type": "number",
            "format": "double"
          },
          "ci_low": {
            "type": "number",
            "format": "double",
            "description": "Intervalo del 95 % de la pendiente, por década."
          },
          "intercept": {
            "type": "number",
            "format": "double",
            "description": "En años calendario: `valor ≈ intercept + slope_per_decade / 10 × año`."
          },
          "lag1": {
            "type": "number",
            "format": "double",
            "description": "Autocorrelación de orden 1."
          },
          "n_years": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "p_value": {
            "type": "number",
            "format": "double",
            "description": "Antes de Benjamini-Hochberg."
          },
          "pct_change_per_decade": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Solo lluvia."
          },
          "q_value": {
            "type": "number",
            "format": "double",
            "description": "Después de Benjamini-Hochberg."
          },
          "slope_per_decade": {
            "type": "number",
            "format": "double",
            "description": "Unidad de la variable por década."
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "year_end": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "year_start": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Status": {
        "type": "string",
        "description": "Semáforo de la tendencia.",
        "enum": [
          "real",
          "posible_casualidad",
          "pocos_datos"
        ]
      },
      "Variable": {
        "type": "string",
        "enum": [
          "lluvia",
          "temperatura",
          "lluvia_imerg"
        ]
      },
      "VariableInfo": {
        "type": "object",
        "description": "`GET /api/variables`: una entrada de `data/variables.json`, tal cual.",
        "required": [
          "id",
          "unidad",
          "fuente",
          "descripcion",
          "anio_inicio",
          "anio_fin"
        ],
        "properties": {
          "anio_fin": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "anio_inicio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "descripcion": {
            "type": "string"
          },
          "fuente": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Zona": {
        "type": "object",
        "description": "`GET /api/zonas`: una zona del mapa con su tendencia (sin serie).",
        "required": [
          "id",
          "nombre",
          "lat",
          "lon",
          "celdas",
          "stats"
        ],
        "properties": {
          "celdas": {
            "type": "integer",
            "format": "int32",
            "description": "Celdas de la malla de la fuente que entran en el promedio.",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "description": "Ubigeo como texto: \"01\"–\"25\"."
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "nombre": {
            "type": "string"
          },
          "nota": {
            "type": [
              "string",
              "null"
            ],
            "description": "Aviso si el promedio es poco fiable (menos de 4 celdas): mostrarlo en la ficha."
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          }
        },
        "additionalProperties": false
      },
      "ZonaCobertura": {
        "type": "object",
        "description": "`GET /api/cobertura-arboles`: una zona (recuadro de selva) con su serie anual y su tendencia.",
        "required": [
          "id",
          "nombre",
          "departamento",
          "ubigeo",
          "tipo",
          "unidad_geografica",
          "bbox",
          "lat",
          "lon",
          "pixeles",
          "fuente",
          "umbral_bosque_pct",
          "tendencia_de",
          "serie",
          "stats"
        ],
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "`[oeste, sur, este, norte]` en grados."
          },
          "departamento": {
            "type": "string",
            "description": "Departamento donde está el recuadro."
          },
          "fuente": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Identificador del recuadro, p. ej. \"la-pampa\"."
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "nombre": {
            "type": "string"
          },
          "pixeles": {
            "type": "integer",
            "format": "int32",
            "description": "Píxeles MODIS (~250 m) de tierra del recuadro.",
            "minimum": 0
          },
          "serie": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnioCobertura"
            },
            "description": "Un punto por año, de menor a mayor (como `serie` de `/api/zonas/{id}`)."
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "tendencia_de": {
            "type": "string",
            "description": "Sobre qué campo de `serie` se calcula `stats` (hoy, \"arboles_pct\")."
          },
          "tipo": {
            "type": "string",
            "description": "P. ej. \"selva con minería de oro\"."
          },
          "ubigeo": {
            "type": "string",
            "description": "Ubigeo del departamento, como texto (\"01\"–\"25\")."
          },
          "umbral_bosque_pct": {
            "type": "number",
            "format": "double",
            "description": "% de cobertura de árboles desde el que un píxel cuenta como bosque."
          },
          "unidad_geografica": {
            "type": "string",
            "description": "Qué área se promedia: un recuadro, **no** el departamento. La ficha debe mostrarlo."
          }
        },
        "additionalProperties": false
      },
      "ZonaDetalle": {
        "type": "object",
        "description": "`GET /api/zonas/{id}`: los campos de `Zona` (con su `stats`) más la serie anual del mismo periodo.\nCampos explícitos y no `flatten`: `Zona` lleva `additionalProperties: false` (por `deny_unknown_fields`)\ny un `allOf` contradiría el contrato. Un test comprueba que no se desincronicen.",
        "required": [
          "id",
          "nombre",
          "lat",
          "lon",
          "celdas",
          "variable",
          "unidad",
          "fuente",
          "serie",
          "stats"
        ],
        "properties": {
          "celdas": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "fuente": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "nombre": {
            "type": "string"
          },
          "nota": {
            "type": [
              "string",
              "null"
            ],
            "description": "Aviso si el promedio es poco fiable (menos de 4 celdas): mostrarlo en la ficha."
          },
          "serie": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Punto"
            }
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "unidad": {
            "type": "string"
          },
          "variable": {
            "type": "string"
          }
        }
      },
      "ZonaVegetacion": {
        "type": "object",
        "description": "`GET /api/vegetacion`: una zona (recuadro sobre un valle) con su serie anual y su tendencia.",
        "required": [
          "id",
          "nombre",
          "departamento",
          "ubigeo",
          "tipo",
          "unidad_geografica",
          "bbox",
          "lat",
          "lon",
          "pixeles",
          "fuente",
          "umbral_verde_ndvi",
          "tendencia_de",
          "serie",
          "stats"
        ],
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "`[oeste, sur, este, norte]` en grados."
          },
          "departamento": {
            "type": "string",
            "description": "Departamento donde está el recuadro."
          },
          "fuente": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Identificador del recuadro, p. ej. \"chavimochic\"."
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "nombre": {
            "type": "string"
          },
          "pixeles": {
            "type": "integer",
            "format": "int32",
            "description": "Píxeles MODIS (~1 km) del recuadro.",
            "minimum": 0
          },
          "serie": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnioVegetacion"
            },
            "description": "Un punto por año, de menor a mayor (como `serie` de `/api/zonas/{id}`): solo años completos."
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "tendencia_de": {
            "type": "string",
            "description": "Sobre qué campo de `serie` se calcula `stats` (hoy, \"ndvi_anual\")."
          },
          "tipo": {
            "type": "string",
            "description": "P. ej. \"valle irrigado\" o, en Olmos, \"riego nuevo y bosque seco\"."
          },
          "ubigeo": {
            "type": "string",
            "description": "Ubigeo del departamento, como texto (\"01\"–\"25\")."
          },
          "umbral_verde_ndvi": {
            "type": "number",
            "format": "double",
            "description": "NDVI desde el que un píxel cuenta como área verde."
          },
          "unidad_geografica": {
            "type": "string",
            "description": "Qué área se promedia: un recuadro, **no** el departamento. La ficha debe mostrarlo."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
